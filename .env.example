# Server-only runtime configuration. Copy to ignored .env.local and fill locally.
# Generate owner auth values with the scripts documented in README.md.
APP_ORIGIN=http://localhost:3000
OWNER_PASSWORD_HASH=
SESSION_SECRET=

# From YOUR Supabase project: direct endpoint or session pooler (port 5432).
# URL-encode password characters. Never use NEXT_PUBLIC_DATABASE_URL.
DATABASE_URL=postgresql://postgres.PROJECT_REF:URL_ENCODED_PASSWORD@YOUR_SESSION_POOLER_HOST:5432/postgres?sslmode=verify-full
# Optional trusted Supabase/private CA certificate, mounted read-only on server:
# DATABASE_CA_CERT_PATH=/run/secrets/database-ca.crt

# Provider API keys are encrypted on disk, not stored in PostgreSQL.
NAIL_SECRET_DIR=/var/lib/nail/secrets
NAIL_SECRET_ENCRYPTION_KEY=
# NAIL_CONNECTOR_SOCKET=/socket/provider.sock
# Do not pass DATABASE_URL or the app secret mount to the private connector.
